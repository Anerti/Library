{
	"nodes":[
		{"id":"42be7b2a078e4fb7","type":"text","text":"# library\n\n- `id uuid pk`\n- `name varchar(100) not null`\n- `phone varchar(30) not null`\n- `email varchar(100) not null`\n- `address varchar(100) not null`","x":-291,"y":-1000,"width":520,"height":297},
		{"id":"3bbc9933dc59b1d4","type":"text","text":"# book_copy\n\n- `id uuid pk`\n- `price numeric not null`\n- `format enum(HARDCOVER, PAPERBACK, POCKET) not null`\n- `library_id uuid fk references library(id) not null`\n- `book_id uuid fk references book(id) not null`\n- `status enum(available, sold_out) default available`\n- `page_number int not null`\n- `updated_at timestamp default now()`","x":-326,"y":116,"width":591,"height":429},
		{"id":"96a93a215fa9859d","type":"text","text":"# arrival\n\n- `id uuid pk`\n- `created_at timestamp now()`\n- `arrival_date timestamp default now()`\n- `library_id uuid references library(id) not null`","x":1440,"y":116,"width":620,"height":429},
		{"id":"d5b05aa0ef758fb9","type":"text","text":"# library_arrival","x":1625,"y":-881,"width":250,"height":60,"color":"6"},
		{"id":"d54cbf1a60f5d63c","type":"text","text":"# sale_book_copy (sale_item)\n\n- `(book_copy_id, sale_id) unique`\n- `book_copy_id uuid references book_copy(id) not null`\n- `sale_id uuid references sale(id) not null`\n- `created_at timestamp default now()`\n- `quantity int default 1`\n- `price numeric not null`","x":-1260,"y":211,"width":591,"height":240,"color":"6"},
		{"id":"96fe8288917f91ac","type":"text","text":"# customer_sale","x":-2089,"y":880,"width":250,"height":60,"color":"6"},
		{"id":"cb68a0335f447150","type":"text","text":"# customer\n\n- `id uuid pk`\n- `last_name varchar(100) not null`\n- `first_name varchar(100)`\n- `birth_date date not null`\n- `email varchar(100) not null`\n- `password varchar(255) not null`\n- `phone varchar(30)`\n- `updated_at timestamp now()`\n- `created_at timestamp now()`","x":-2260,"y":1340,"width":591,"height":320},
		{"id":"ec136f60c48d35d0","type":"text","text":"# library_sale","x":-2089,"y":-881,"width":250,"height":60,"color":"6"},
		{"id":"9e05d223e92d1d70","type":"text","text":"# sale\n\n- `id uuid pk`\n- `sale_date timestamp now()`\n- `customer_id uuid fk references customer(id) not null`\n- `status enum(sold, booked, expired) default booked`\n- `library_id uuid fk references library(id) not null`\n- `created_at timestamp now()`","x":-2264,"y":171,"width":600,"height":320},
		{"id":"3878e5964e81f16f","type":"text","text":"# author_book\n\n- `(book_id, author_id) unique`\n- `book_id uuid fk references book(id) not null`\n- `author_id uuid fk references author(id) not null`","x":-326,"y":1858,"width":591,"height":244,"color":"6"},
